{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Batas keselamatan milik proyek. Hanya safety enforcement; hook desain dan kenyamanan lokal tinggal di settings.local.json yang di-gitignore. Deny = aksi yang tidak dapat dipulihkan. Ask = penyerahan ke klien, yang menurut CLAUDE.md butuh persetujuan pemilik produk, bukan larangan.",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git filter-branch:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag -d:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc --prune=now:*)",
      "Bash(php artisan migrate)",
      "Bash(php artisan migrate -:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan migrate:refresh:*)",
      "Bash(php artisan migrate:reset:*)",
      "Bash(php artisan migrate:rollback:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(php artisan db:seed --force:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)"
    ]
  }
}
