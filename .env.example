APP_NAME="Memount"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Data contoh lokal (DK-35): true hanya saat menyajikan database/demo.sqlite dengan
# DB_CONNECTION=demo. Setiap halaman lalu memasang lencana "Data contoh".
APP_DEMO=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Aplikasi memakai PostgreSQL dengan ekstensi PostGIS (PRD §65). SQLite hanya dipakai
# oleh suite test, yang mengonfigurasinya sendiri lewat phpunit.xml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hiking
DB_USERNAME=postgres
DB_PASSWORD=

# Postgres + PostGIS untuk suite spasial. Kosongkan bila tidak tersedia; suite-nya
# akan melewati dirinya sendiri, bukan gagal. Kontainer lokal opsional yang sama dengan
# CI: `docker compose up -d postgis`, lalu isi DSN menurut CONTRIBUTING.md bagian
# "Suite spasial di mesin sendiri". Jangan pernah mengarahkannya ke Supabase: suite ini
# mengosongkan seluruh tabel.
SPATIAL_TEST_DSN=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
REPORT_PHOTOS_DISK=local
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=ap-southeast-1
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=

# Peta (PRD §55). Sumber tile dapat diganti tanpa mengubah kode.
# Kontrol atribusi bawaan MapLibre dimatikan (CVE-2026-85061), jadi MAP_ATTRIBUTION wajib
# ditulis manual dan harus memuat atribusi sumber ubin di atas; bila MAP_STYLE_URL diisi
# gaya pihak ketiga, atribusi wajib gaya itu juga wajib ditambahkan ke sini, karena
# atribusinya tidak lagi tampil otomatis dari gaya atau ubin yang dipakai.
MAP_TILE_URL="https://tile.opentopomap.org/{z}/{x}/{y}.png"
MAP_ATTRIBUTION="© OpenStreetMap contributors, SRTM | Tampilan: © OpenTopoMap (CC-BY-SA)"

# Paket lapangan luring dan alat keselamatan trip (spec v3 bagian 10; ruling W6-R3 dan W6-R4).
# Keduanya dibangun dan diuji, tetapi mati sampai pemilik memutus Q10 dan Q14.
FIELD_PACK_ENABLED=false
FIELD_SAFETY_ENABLED=false

# Rahasia kunci perangkat (ruling W6-10c): nama basis data paket lapangan dan perekam jejak di
# perangkat diturunkan dari rahasia ini, atau dari APP_KEY bila kosong. Rahasia ini tidak diputar:
# memutarnya menghapus paket dan jejak yang belum terkirim di setiap perangkat pada kunjungan
# berikutnya, karena penjaga ganti akun melihat kunci lain.
DEVICE_KEY_SECRET=
